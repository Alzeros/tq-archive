--- a/runTcpQuality-core.sh
+++ b/runTcpQuality-core.sh
@@ -1757,6 +1757,21 @@
 upload_report() {
   local csv="$1" report_time="${2:-}" response_file curl_err http_code report_id report_url
   local rank_headers=()
+
+  # ── TQ-Hub 直传（不走 tcpquality.ibsgss.uk）────────────────────────
+  # 设了 TCPQUALITY_TQHUB 时，把 CSV 直接 POST 到自建 TQ Hub 并提前 return，
+  # 完全不生成官方报告链接。配合 --no-rootfs 使用；chroot 坏境变量不通。
+  if [ -n "${TCPQUALITY_TQHUB:-}" ]; then
+    local hub_code
+    hub_code=$(curl -sS --connect-timeout 10 --max-time 30 \
+      -o /dev/null -w '%{http_code}' \
+      -H 'Content-Type: text/csv; charset=utf-8' \
+      -H "X-Report-Time: $report_time" \
+      --data-binary "@$csv" "$TCPQUALITY_TQHUB") || hub_code="curl_failed"
+    echo "[TQ-Hub] HTTP $hub_code"
+    return
+  fi
+
   if ! command -v curl &>/dev/null; then
     echo "  [YELLOW][!] 依赖不完整，已跳过 SVG 报告上传[NC]"
     return
