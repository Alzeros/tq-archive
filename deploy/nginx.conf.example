# 1. 生成密码：htpasswd -c /etc/nginx/.tq htqadmin
# 2. 把 server_name 改成你的域名后启用到 /etc/nginx/conf.d/tq-archive.conf
# 3. 该工具没有内置账号体系，公网访问必须保留下面的 basic auth

server {
    listen 443 ssl;
    http2 on;
    server_name tq.example.com;

    ssl_certificate     /etc/letsencrypt/live/tq.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tq.example.com/privkey.pem;

    auth_basic "TQ Archive";
    auth_basic_user_file /etc/nginx/.tq;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
