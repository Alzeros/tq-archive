# 1. 登录由应用自身处理（/login 页面 + 会话 Cookie），不要再启用 basic auth，
#    否则浏览器会先弹框，应用内的登录页根本走不到。
# 2. 把 server_name 改成你的域名后启用到 /etc/nginx/conf.d/tq-archive.conf
# 3. 记得同步改 systemd 的 ALLOWED_HOSTS / ALLOWED_ORIGINS 为本域名，否则后端会返回 403
#    （$host 不含端口，带端口与不带端口的写法后端都接受）

server {
    listen 443 ssl;
    http2 on;
    server_name tq.example.com;

    ssl_certificate     /etc/letsencrypt/live/tq.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tq.example.com/privkey.pem;

    # 报告抓取在服务端完成，浏览器只发 JSON，这里留有余量即可
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 同步节点需连探针 WebSocket，后端处理较久，放宽超时
        proxy_read_timeout 120s;
    }
}
