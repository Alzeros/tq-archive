[Unit]
Description=TQ Report Archive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tq-archive
ExecStart=/usr/bin/node server.mjs
Environment=PORT=4173
Environment=DATA_DIR=/opt/tq-archive/data
# 反代到域名后，把下面两行改成对应域名，否则 Host 校验会拒绝请求。
# 端口可省略：带端口与不带端口的形式都会被接受。
# Environment=ALLOWED_HOSTS=127.0.0.1:4173,tq.example.com
# Environment=ALLOWED_ORIGINS=https://tq.example.com
# 账号密码放在 /etc/tq-archive.env（chmod 600，仅 root 可读），不要写进本文件。
# 未配置时后端不启用登录，仅适合本机直连；公网部署必须配置。
# AUTH_SECURE=1 让会话 Cookie 带 Secure（走 https 时必开）。
EnvironmentFile=-/etc/tq-archive.env
Restart=always
RestartSec=3
User=tq
Group=tq
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# data/ 下含 database.json、reports/ 与 raw/，整目录放行
ReadWritePaths=/opt/tq-archive/data

[Install]
WantedBy=multi-user.target
